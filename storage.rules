rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function: Authenticated and UID matches path owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Default deny all undefined Storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Beekeeper's own HoneyLot inspection report files:
    // users/{uid}/honeyLots/{lotId}/inspection-report/{fileName}
    // - No public read rule; only owner can read/write/delete via Storage API
    // - Enforces 10MB size limit and PDF/JPG/JPEG/PNG content types
    match /users/{uid}/honeyLots/{lotId}/inspection-report/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && (
        request.resource == null || (
          request.resource.size <= 10 * 1024 * 1024 &&
          request.resource.contentType.matches('application/pdf|image/jpeg|image/jpg|image/pjpeg|image/png')
        )
      );
    }

    // Beekeeper's Product representative photos:
    // users/{uid}/products/{productId}/{fileName}
    // - Raw storage files protected: only owner can read/write via Storage API
    // - 10MB size limit and image types enforced
    match /users/{uid}/products/{productId}/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && (
        request.resource == null || (
          request.resource.size <= 10 * 1024 * 1024 &&
          request.resource.contentType.matches('image/jpeg|image/jpg|image/pjpeg|image/png|image/webp')
        )
      );
    }
  }
}
