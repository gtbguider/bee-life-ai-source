# KMA_API_KEY: Korea Meteorological Administration Public Data Portal Service Key
KMA_API_KEY="7xVwWwsKgBoKJDMY0nir5ZsUdA4X6G%2FAq7LvtWC3fTDYtgMxgyDgeXtQoP1DpfC89vrhVm%2FgQI9r1VpbDBirlA%3D%3D"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (auto-loaded from firebase-applet-config.json or environment)
VITE_FIREBASE_API_KEY=""
